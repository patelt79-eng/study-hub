    { "id": "fr-q-01", "set": "verbs", "q": "How do you say 'I have' in French?", "options": ["je suis", "j'ai", "je vais", "je fais"], "answer": 1, "explain": "J'ai comes from avoir, to have.", "source": "generated" },
    { "id": "fr-q-02", "set": "verbs", "q": "How do you say 'I go' in French?", "options": ["je vais", "j'ai", "je fais", "je suis"], "answer": 0, "explain": "Je vais comes from aller, to go.", "source": "generated" },
    { "id": "fr-q-03", "set": "verbs", "q": "What does 'nous sommes' mean?", "options": ["we have", "we go", "we do", "we are"], "answer": 3, "explain": "Sommes comes from être, to be.", "source": "generated" },
    { "id": "fr-q-04", "set": "verbs", "q": "Which is the correct form: 'ils ___' (they do)?", "options": ["font", "faites", "faisons", "fait"], "answer": 0, "explain": "Faire: ils font.", "source": "generated" },
    { "id": "fr-q-05", "set": "verbs", "q": "Which is the correct form: 'vous ___' (you are)?", "options": ["sont", "sommes", "êtes", "es"], "answer": 2, "explain": "Être: vous êtes.", "source": "generated" },
    { "id": "fr-q-06", "set": "verbs", "q": "What does 'j'ai regardé' mean?", "options": ["I watch", "I watched", "I will watch", "I am watching"], "answer": 1, "explain": "J'ai + regardé is the passé composé, the past tense.", "source": "generated" },
    { "id": "fr-q-07", "set": "verbs", "q": "How do you say 'I went' in French?", "options": ["j'ai allé", "je vais", "j'allé", "je suis allé"], "answer": 3, "explain": "Aller uses être in the passé composé: je suis allé (or allée).", "source": "generated" },
    { "id": "fr-q-08", "set": "verbs", "q": "What is the past participle of 'manger' (to eat)?", "options": ["mangé", "mangu", "mangi", "manger"], "answer": 0, "explain": "-er verbs change to -é: mangé.", "source": "generated" },
    { "id": "fr-q-09", "set": "verbs", "q": "What does 'j'ai lu' mean?", "options": ["I saw", "I read (in the past)", "I played", "I listened"], "answer": 1, "explain": "Lu is the past participle of lire, to read.", "source": "generated" },
